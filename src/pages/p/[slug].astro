---
import { getCollection } from 'astro:content';

import Layout from '@/Layout.astro';
import Solution from '@sections/Solution.astro';

import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'dataStructures'>['data'] & Partial<CollectionEntry<'problems'>['data']>;

const MIN_DESCRIPTION_LENGTH = 120;

const { code, difficulty, lang, langLabel, title } = Astro.props;

const base = difficulty
    ? `${title}: ${langLabel} solution to the ${difficulty} practice problem`
    : `${title}: ${langLabel} implementation of the data structure`;

let description = `${base}.`;

if (description.length < MIN_DESCRIPTION_LENGTH) description = `${base} with copyable source code from Algo.`;
if (description.length < MIN_DESCRIPTION_LENGTH) description = `${base} with copyable source code from the Algo archive of LeetCode solutions.`;

export async function getStaticPaths() {
    const [dataStructures, problems] = await Promise.all([
        getCollection('dataStructures'),
        getCollection('problems'),
    ]);

    return [
        ...dataStructures.map(entry => ({
            params: { slug: entry.id },
            props: { ...entry.data },
        })),
        ...problems.map(entry => ({
            params: { slug: entry.id },
            props: { ...entry.data },
        })),
    ];
}
---

<Layout
    description={description}
    title={`${title} \u2014 Algo`}
>
    <Solution
        code={code}
        difficulty={difficulty}
        lang={lang}
        langLabel={langLabel}
        title={title}
    />
</Layout>
