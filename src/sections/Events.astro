---
import EventCard from '@components/EventCard.astro';
import { MEETUP_URL } from '@lib/constants';

import type { ComponentProps } from 'astro/types';

type MeetupEvent = NonNullable<ComponentProps<typeof EventCard>['event']>;

interface ApolloEvent {
    dateTime: string;
    endTime: string;
    eventUrl: string;
    status: string;
    title: string;
    venue: { __ref: string } | null;
}

interface ApolloVenue {
    city: string;
    name: string;
}

const FETCH_TIMEOUT = 10_000;
const MAX_EVENTS = 5;

const events = await fetchEvents();

async function fetchEvents() {
    try {
        const response = await fetch(`${MEETUP_URL}/events/?t=${Date.now()}`, { signal: AbortSignal.timeout(FETCH_TIMEOUT) });

        if (!response.ok) return [];

        const html = await response.text();

        const match = html.match(/<script id="__NEXT_DATA__"[^>]*>([\s\S]*?)<\/script>/);

        if (!match) return [];

        const state: Record<string, unknown> | undefined = JSON.parse(match[1])?.props?.pageProps?.__APOLLO_STATE__;

        if (!state) return [];

        const events: MeetupEvent[] = [];

        for (const [key, value] of Object.entries(state)) {
            if (!key.startsWith('Event:')) continue;

            const { dateTime, endTime, eventUrl, status, title, venue: venueRef } = value as ApolloEvent;

            const endTimestamp = Date.parse(endTime);
            const startTimestamp = Date.parse(dateTime);

            if (!eventUrl || !title || status !== 'ACTIVE') continue;
            if (Number.isNaN(endTimestamp) || Number.isNaN(startTimestamp) || endTimestamp < startTimestamp) continue;

            const venue = venueRef ? state[venueRef.__ref] as ApolloVenue | undefined : undefined;

            events.push({ city: venue?.city ?? '', dateTime, endTime, title, url: eventUrl, venue: venue?.name ?? '' });
        }

        return events.sort((a, b) => Date.parse(a.dateTime) - Date.parse(b.dateTime));
    } catch {
        return [];
    }
}
---

<section
    class="events section"
    aria-label="Events"
>
    <div class="shell">
        <h2
            class="mb-(--heading-margin) indent-[0.3em] text-center text-heading tracking-[0.3em] uppercase text-zinc-200"
            data-scroll
        >
            Events
        </h2>
        <ul
            class="flex flex-col gap-(--gap-l)"
            data-scroll
            data-scroll-stagger="0.1"
        >
            {events.length === 0
                ? <li><EventCard /></li>
                : events.slice(0, MAX_EVENTS).map(event => <li><EventCard event={event} /></li>)}
        </ul>
    </div>
</section>
