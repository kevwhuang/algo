---
const year = new Intl.DateTimeFormat('en-US', { timeZone: 'America/Chicago', year: 'numeric' }).format(new Date());
---

<footer class="section border-t border-white-10 bg-zinc-950">
    <div class="shell">
        <p class="text-center text-sm text-zinc-400">
            &copy; <time datetime={year}>{year}</time>{' '}
            <a
                class="active:opacity-85 focus-visible:text-cyan hover:text-cyan underline underline-offset-2 duration-(--duration-fast) transition-[color,opacity]"
                aria-label="Aephonics (opens in new tab)"
                href="https://aephonics.com"
                target="_blank"
            >
                Aephonics
            </a>
            . All rights reserved.
        </p>
    </div>
</footer>
