---
import { Code } from 'astro:components';

import type { ComponentProps } from 'astro/types';
import type { ShikiTransformer } from 'shiki';

interface Props {
    code: string;
    difficulty?: keyof typeof DIFFICULTY_CLASSES;
    lang: ComponentProps<typeof Code>['lang'];
    langLabel: string;
    title: string;
}

const CLASS_BADGE = 'inline-block pl-3 pr-[calc(0.75rem-0.1em)] py-1 rounded-full capitalize font-mono text-xs tracking-widest';
const CLASS_COPY = 'solution__copy active:opacity-85 focus-visible:text-cyan hover:text-cyan inline-block relative px-3 py-1 rounded font-mono text-sm text-zinc-400 duration-(--duration-fast) transition-[color,opacity] select-none';

const DIFFICULTY_CLASSES = {
    easy: 'bg-emerald-15 text-emerald',
    hard: 'bg-red-15 text-red',
    medium: 'bg-amber-15 text-amber',
} as const;

const HIGHLIGHT_TRANSFORMER: ShikiTransformer = {
    code(node) {
        this.addClassToHast(node, 'solution__code [counter-reset:line] block min-w-full w-max p-(--gap-s) text-frost');
    },
    line(node) {
        node.children = node.children.map(child => child.type === 'element' && child.properties.style === 'color:#E6EDF3'
            ? child.children[0]
            : child);

        this.addClassToHast(node, 'solution__line [counter-increment:line] before:content-[counter(line)_/_""] before:inline-block before:mr-(--gap-s) before:select-none before:text-right before:text-zinc-400 before:w-[2em]');
    },
    pre(node) {
        this.addClassToHast(node, 'solution__pre overflow-x-auto leading-7 text-sm');
        delete node.properties.style;
    },
};

const { code, difficulty, lang, langLabel, title } = Astro.props;
---

<section
    class="section solution"
    aria-label={title}
>
    <div class="shell">
        <h1
            class="mb-(--heading-margin) font-bold leading-tight text-balance text-heading wrap-anywhere text-zinc-200"
            data-scroll
        >
            {title}
        </h1>
        <section
            class="overflow-hidden border border-zinc-800 rounded-lg"
            aria-label={`${title} source code`}
            data-scroll
        >
            <div class="flex items-center justify-between px-(--gap-s) py-3 border-b border-zinc-800 bg-zinc-900">
                <dl class="flex flex-wrap gap-3">
                    <div class="contents">
                        <dt class="sr-only">Language</dt>
                        <dd class={`${CLASS_BADGE} bg-cyan-15 text-cyan`}>{langLabel}</dd>
                    </div>
                    {difficulty && (
                        <div class="contents">
                            <dt class="sr-only">Difficulty</dt>
                            <dd class={`${CLASS_BADGE} ${DIFFICULTY_CLASSES[difficulty]}`}>{difficulty}</dd>
                        </div>
                    )}
                </dl>
                <button
                    class={CLASS_COPY}
                    aria-label="Copy code"
                    type="button"
                >
                    <span class="solution__label duration-(--duration-base) transition-opacity">Copy</span>
                </button>
            </div>
            <Code
                code={code}
                lang={lang}
                theme="github-dark-default"
                transformers={[HIGHLIGHT_TRANSFORMER]}
            />
            <div class="solution__status sr-only" aria-live="polite" />
        </section>
    </div>
</section>

<style>
    .solution__copy::after {
        content: '';
        inset: -0.625rem 0;
        position: absolute;
    }

    .solution__copy--fading .solution__label {
        opacity: 0;
    }

    .solution__pre:focus-visible {
        outline-offset: -0.125rem;
    }

    @media (max-width: 768px) {
        .solution__copy {
            display: none;
        }
    }
</style>

<script>
    const COPY_RESET_DELAY = 2_000;
    const LABEL_COPIED = 'Code copied to clipboard.';
    const LABEL_FAILED = 'Failed to copy code.';

    let copyController: AbortController | null = null;
    let resetTimer = 0;

    async function handleCopy(event: Event) {
        const button = event.currentTarget;

        if (!(button instanceof HTMLButtonElement)) return;

        const code = document.querySelector('.solution__code')?.textContent ?? '';
        const status = document.querySelector('.solution__status');

        try {
            await navigator.clipboard.writeText(code);

            queueSwap(button, 'Copied', LABEL_COPIED);

            if (status) status.textContent = LABEL_COPIED;
        } catch {
            queueSwap(button, 'Failed', LABEL_FAILED);

            if (status) status.textContent = LABEL_FAILED;
        }

        clearTimeout(resetTimer);

        resetTimer = window.setTimeout(() => {
            queueSwap(button, 'Copy', 'Copy code');

            if (status) status.textContent = '';
        }, COPY_RESET_DELAY);
    }

    function handleTransitionEnd(event: TransitionEvent) {
        if (event.propertyName !== 'opacity') return;
        if (!(event.target instanceof HTMLElement) || !event.target.classList.contains('solution__label')) return;

        const button = event.currentTarget;

        if (!(button instanceof HTMLButtonElement)) return;
        if (!button.classList.contains('solution__copy--fading')) return;

        const label = button.querySelector('.solution__label');

        if (label) label.textContent = button.dataset.pendingText ?? '';

        button.classList.remove('solution__copy--fading');
        button.setAttribute('aria-label', button.dataset.pendingLabel ?? '');
    }

    function initCopy() {
        clearTimeout(resetTimer);
        copyController?.abort();
        copyController = new AbortController();

        const { signal } = copyController;

        for (const button of document.querySelectorAll<HTMLButtonElement>('.solution__copy')) {
            button.addEventListener('click', handleCopy, { signal });
            button.addEventListener('transitionend', handleTransitionEnd, { signal });
        }
    }

    function queueSwap(button: HTMLButtonElement, text: string, label: string) {
        button.dataset.pendingLabel = label;
        button.dataset.pendingText = text;
        button.classList.add('solution__copy--fading');
    }

    document.addEventListener('astro:page-load', initCopy);
</script>
