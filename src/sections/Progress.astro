---
import { getCollection } from 'astro:content';

import { DIFFICULTIES } from '@lib/constants';

const DIFFICULTY_CLASSES = {
    easy: { bar: 'from-emerald to-emerald-bright', label: 'text-emerald', track: 'bg-emerald-15' },
    hard: { bar: 'from-red to-red-bright', label: 'text-red', track: 'bg-red-15' },
    medium: { bar: 'from-amber to-amber-bright', label: 'text-amber', track: 'bg-amber-15' },
} as const;

const MIN_SOLUTION_LINES = 3;
const PERCENT = 100;

const problems = (await getCollection('problems')).filter(entry => !entry.filePath?.includes('front-end'));

const stats = DIFFICULTIES.map((difficulty) => {
    const entries = problems.filter(entry => entry.data.difficulty === difficulty);

    return {
        classes: DIFFICULTY_CLASSES[difficulty],
        completed: entries.filter(entry => entry.data.code.trim().split('\n').length >= MIN_SOLUTION_LINES).length,
        difficulty,
        total: entries.length,
    };
});
---

<section
    class="progress section"
    aria-label="Progress"
>
    <div class="shell">
        <h1 class="sr-only">Algo</h1>
        <h2
            class="mb-(--heading-margin) indent-[0.3em] text-center text-heading tracking-[0.3em] uppercase text-zinc-200"
            data-scroll
        >
            Progress
        </h2>
        <ul
            class="flex flex-col gap-(--gap-l)"
            data-scroll
            data-scroll-stagger="0.1"
        >
            {stats.map(({ classes, completed, difficulty, total }) => {
                const percent = total > 0 ? Math.round((completed / total) * PERCENT) : 0;

                return (
                    <li>
                        <dl class="flex items-baseline justify-between mb-3">
                            <dt class={`capitalize font-semibold text-title ${classes.label}`}>{difficulty}</dt>
                            <dd class="font-mono text-lead">
                                {completed}
                                <span class="text-zinc-400">/{total}</span>
                            </dd>
                        </dl>
                        <div
                            class={`overflow-hidden h-4 rounded-full ${classes.track}`}
                            aria-label={`${difficulty} progress`}
                            aria-valuemax={total}
                            aria-valuemin={0}
                            aria-valuenow={completed}
                            role="progressbar"
                        >
                            <div class={`progress__bar h-full w-0 rounded-full bg-linear-to-r ${classes.bar}`} data-progress={percent} />
                        </div>
                    </li>
                );
            })}
        </ul>
    </div>
</section>
