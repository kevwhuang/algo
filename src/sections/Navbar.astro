---
import IconLeetCode from '@components/IconLeetCode.astro';
import IconLogo from '@components/IconLogo.astro';
import IconMeetup from '@components/IconMeetup.astro';
import IconSearch from '@components/IconSearch.astro';
import { MEETUP_URL, ROUTES } from '@lib/constants';

const CLASS_HINT = 'navbar__hint absolute right-4 top-1/2 px-2 py-1 border border-zinc-700 rounded font-mono text-xs text-zinc-400 -translate-y-1/2 pointer-events-none select-none';
const CLASS_INPUT = 'navbar__input focus-visible:bg-zinc-900 focus-visible:border-cyan-80 hover:bg-zinc-900 hover:border-zinc-600 w-full pl-11 pr-14 py-3 border border-zinc-800 rounded-lg text-base bg-zinc-950 placeholder-zinc-400 text-zinc-300 duration-(--duration-fast) transition-colors';
const MAX_RESULTS = 20;

const RESULT_SLOTS = Array.from({ length: MAX_RESULTS }, (_, index) => index);
---

<header class="navbar fixed top-0 z-50 h-(--header-height) w-full border-b border-white-10 bg-zinc-950">
    <nav
        class="navbar__inner shell flex items-center justify-between h-full gap-(--navbar-gap)"
        aria-label="Main"
    >
        <a
            class="navbar__link active:opacity-85 focus-visible:opacity-80 hover:opacity-80 flex relative duration-(--duration-fast) transition-opacity"
            aria-label={ROUTES[0].label}
            href={ROUTES[0].href}
        >
            <IconLogo />
        </a>
        <search class="navbar__search flex-1 relative max-w-xl">
            <label class="contents">
                <span class="sr-only">Search solutions</span>
                <input
                    class={CLASS_INPUT}
                    aria-autocomplete="list"
                    aria-controls="search-results"
                    aria-expanded="false"
                    autocomplete="off"
                    placeholder="Search&hellip;"
                    role="combobox"
                    type="text"
                />
            </label>
            <IconSearch />
            <kbd
                class={CLASS_HINT}
                aria-hidden="true"
            >
                /
            </kbd>
            <div
                id="search-results"
                class="navbar__results absolute box-content left-0 overflow-y-auto right-0 top-[calc(100%+1rem)] border border-zinc-800 rounded-lg bg-zinc-900"
                aria-label="Search results"
                role="listbox"
                tabindex="-1"
            >
                {RESULT_SLOTS.map(index => (
                    <a
                        id={`search-result-${index}`}
                        class="navbar__result flex items-center justify-between gap-3 p-4 text-sm text-zinc-300 duration-(--duration-fast) transition-[background-color,box-shadow,color]"
                        aria-selected="false"
                        hidden
                        href="/"
                        role="option"
                        tabindex="-1"
                    >
                        <span class="navbar__result-title truncate" />
                        <span class="navbar__badge px-2 py-0.5 rounded-full font-mono indent-[0.1em] text-xs tracking-widest uppercase duration-(--duration-fast) transition-colors" />
                    </a>
                ))}
                <div
                    id="search-message"
                    class="navbar__message p-4 text-sm text-zinc-300"
                    aria-disabled="true"
                    aria-selected="false"
                    hidden
                    role="option"
                >
                    No results.
                </div>
            </div>
        </search>
        <ul class="flex items-center gap-(--navbar-gap)">
            <li>
                <a
                    class="navbar__link active:opacity-85 focus-visible:opacity-80 hover:opacity-80 flex relative duration-(--duration-fast) transition-opacity"
                    aria-label="Meetup (opens in new tab)"
                    href={MEETUP_URL}
                    target="_blank"
                >
                    <IconMeetup />
                </a>
            </li>
            <li>
                <a
                    class="navbar__link active:opacity-85 focus-visible:opacity-80 hover:opacity-80 flex relative duration-(--duration-fast) transition-opacity"
                    aria-label="LeetCode (opens in new tab)"
                    href="https://leetcode.com/u/aephonics"
                    target="_blank"
                >
                    <IconLeetCode />
                </a>
            </li>
        </ul>
    </nav>
</header>

<style>
    .navbar {
        --navbar-gap: clamp(1rem, calc(0.6667rem + 1.6667vw), 2rem);
    }

    .navbar__badge[data-difficulty='ds'] {
        background-color: var(--color-cyan-15);
        color: var(--color-cyan);
    }

    .navbar__badge[data-difficulty='easy'] {
        background-color: var(--color-emerald-15);
        color: var(--color-emerald);
    }

    .navbar__badge[data-difficulty='hard'] {
        background-color: var(--color-red-15);
        color: var(--color-red);
    }

    .navbar__badge[data-difficulty='medium'] {
        background-color: var(--color-amber-15);
        color: var(--color-amber);
    }

    .navbar__link::after {
        content: '';
        inset: calc((var(--size-icon) - 3rem) / 2);
        position: absolute;
    }

    .navbar__result:where([aria-selected='true']) {
        background-color: var(--color-zinc-800);
        box-shadow: inset 0.125rem 0 0 var(--color-cyan-80);
        color: var(--color-cyan);
    }

    .navbar__result:where([aria-selected='true']) .navbar__badge[data-difficulty='hard'] {
        color: var(--color-red-bright);
    }

    .navbar__results {
        max-height: min(26rem, calc(100dvh - var(--header-height) - 2rem));
        opacity: 0;
        pointer-events: none;
        scrollbar-color: var(--color-zinc-500) transparent;
        scrollbar-width: thin;
        transition:
            opacity var(--duration-base) ease,
            visibility 0s var(--duration-base);
        visibility: hidden;
    }

    .navbar__results--open {
        opacity: 1;
        pointer-events: auto;
        transition: opacity var(--duration-base) ease;
        visibility: visible;
    }

    @media (max-width: 768px) {
        .navbar__badge,
        .navbar__hint {
            display: none;
        }

        .navbar__input {
            padding-right: 0.75rem;
        }

        .navbar__results {
            left: var(--shell-pad);
            position: fixed;
            right: var(--shell-pad);
            top: calc(var(--header-height) + 1rem);
        }
    }
</style>

<script>
    interface SearchEntry {
        difficulty: string;
        id: string;
        title: string;
    }

    let activeIndex = -1;
    let controller: AbortController | null = null;
    let emptyMessage: HTMLElement | null = null;
    let indexPromise: Promise<SearchEntry[] | null> | null = null;
    let input: HTMLInputElement | null = null;
    let isPointerInResults = false;
    let results: HTMLElement | null = null;
    let searchBox: HTMLElement | null = null;

    function closeResults() {
        if (!input || !results) return;

        activeIndex = -1;
        isPointerInResults = false;
        input.removeAttribute('aria-activedescendant');
        input.setAttribute('aria-expanded', 'false');
        results.classList.remove('navbar__results--open');
        results.querySelectorAll('.navbar__result').forEach(item => item.setAttribute('aria-selected', 'false'));
    }

    async function fetchIndex() {
        try {
            const response = await fetch('/api/search.json');

            if (!response.ok) {
                indexPromise = null;

                return null;
            }

            const entries: SearchEntry[] = await response.json();

            return entries;
        } catch {
            indexPromise = null;

            return null;
        }
    }

    function getVisibleResults() {
        return results ? Array.from(results.querySelectorAll<HTMLAnchorElement>('.navbar__result:not([hidden])')) : [];
    }

    function handleDocumentClick(event: MouseEvent) {
        if (!input || !results) return;
        if (!(event.target instanceof Node)) return;
        if (input.contains(event.target) || results.contains(event.target)) return;

        closeResults();
    }

    function handleDocumentKeydown(event: KeyboardEvent) {
        if (!input || !searchBox) return;

        if (!event.altKey && !event.ctrlKey && !event.metaKey && document.activeElement !== input && event.key === '/') {
            event.preventDefault();
            input.focus();

            return;
        }

        if (event.key === 'Escape' && searchBox.contains(document.activeElement)) {
            if (input.getAttribute('aria-expanded') === 'true') closeResults();
            else input.value = '';
        }
    }

    function handleFocus() {
        if (!input) return;

        if (input.value) search(input.value);
    }

    function handleFocusOut(event: FocusEvent) {
        if (!searchBox) return;
        if (event.relatedTarget instanceof Node && searchBox.contains(event.relatedTarget)) return;

        closeResults();
    }

    function handleInput() {
        if (!input) return;

        search(input.value);
    }

    function handleInputKeydown(event: KeyboardEvent) {
        if (!input) return;

        if (!input.value && event.key === '/') event.preventDefault();

        const items = getVisibleResults();

        if (!items.length || input.getAttribute('aria-expanded') !== 'true') return;

        if (event.key === 'ArrowDown') {
            event.preventDefault();
            setActiveResult(activeIndex < items.length - 1 ? activeIndex + 1 : 0);
        } else if (event.key === 'ArrowUp') {
            event.preventDefault();
            setActiveResult(activeIndex > 0 ? activeIndex - 1 : items.length - 1);
        } else if (activeIndex >= 0 && event.key === 'Enter') {
            event.preventDefault();
            items[activeIndex].click();
        }
    }

    function handleResultsPointerOver(event: PointerEvent) {
        if (!(event.target instanceof Element)) return;

        const item = event.target.closest<HTMLAnchorElement>('.navbar__result');

        if (!item) return;

        isPointerInResults = true;
        setActiveResult(getVisibleResults().indexOf(item));
    }

    function initSearch() {
        controller?.abort();
        controller = new AbortController();
        searchBox = document.querySelector<HTMLElement>('search');
        input = searchBox?.querySelector<HTMLInputElement>('input') ?? null;
        results = searchBox?.querySelector<HTMLElement>('[role="listbox"]') ?? null;
        emptyMessage = results?.querySelector<HTMLElement>('.navbar__message') ?? null;

        if (!emptyMessage || !input || !results || !searchBox) return;

        const { signal } = controller;

        input.addEventListener('focus', handleFocus, { signal });
        input.addEventListener('input', handleInput, { signal });
        input.addEventListener('keydown', handleInputKeydown, { signal });

        results.addEventListener('pointerleave', () => {
            isPointerInResults = false;
        }, { signal });

        results.addEventListener('pointerover', handleResultsPointerOver, { signal });
        searchBox.addEventListener('focusout', handleFocusOut, { signal });
        loadIndex();
    }

    function loadIndex() {
        indexPromise ??= fetchIndex();

        return indexPromise;
    }

    function openResults() {
        if (!input || !results) return;

        input.setAttribute('aria-expanded', 'true');
        results.classList.add('navbar__results--open');
    }

    function renderResults(matches: SearchEntry[]) {
        if (!emptyMessage || !results) return;

        results.querySelectorAll<HTMLAnchorElement>('.navbar__result').forEach((item, index) => {
            const badge = item.querySelector<HTMLElement>('.navbar__badge');
            const entry = matches[index];
            const title = item.querySelector<HTMLElement>('.navbar__result-title');

            if (!badge || !title) return;

            if (index >= matches.length) {
                badge.textContent = '';
                item.hidden = true;
                title.textContent = '';

                return;
            }

            badge.dataset.difficulty = entry.difficulty;
            badge.textContent = entry.difficulty;
            item.hidden = false;
            item.href = `/p/${entry.id}`;
            title.textContent = entry.title;
        });

        emptyMessage.hidden = true;
        openResults();

        if (!isPointerInResults) setActiveResult(0);
    }

    async function search(query: string) {
        if (!input || !searchBox) return;

        const normalizedQuery = query.trim().toLowerCase();

        if (!normalizedQuery) {
            closeResults();

            return;
        }

        const index = await loadIndex();

        if (!searchBox.contains(document.activeElement) || input.value !== query) return;
        if (!index) return;

        const matches = index.filter(entry => entry.id === normalizedQuery || entry.title.toLowerCase().includes(normalizedQuery));

        if (!matches.length) {
            showEmptyMessage();

            return;
        }

        renderResults(matches);
    }

    function setActiveResult(index: number) {
        if (!input) return;

        const items = getVisibleResults();

        activeIndex = index;
        items.forEach(item => item.setAttribute('aria-selected', 'false'));

        if (index < 0 || index >= items.length) {
            input.removeAttribute('aria-activedescendant');

            return;
        }

        const item = items[index];

        input.setAttribute('aria-activedescendant', item.id);
        item.scrollIntoView({ block: 'nearest' });
        item.setAttribute('aria-selected', 'true');
    }

    function showEmptyMessage() {
        if (!emptyMessage || !input || !results) return;

        activeIndex = -1;
        emptyMessage.hidden = false;
        isPointerInResults = false;
        input.setAttribute('aria-activedescendant', 'search-message');

        results.querySelectorAll<HTMLElement>('.navbar__result').forEach((item) => {
            item.hidden = true;
        });

        openResults();
    }

    document.addEventListener('astro:page-load', initSearch);
    document.addEventListener('click', handleDocumentClick);
    document.addEventListener('keydown', handleDocumentKeydown);
</script>
