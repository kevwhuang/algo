---
import IconLeetCode from '@components/IconLeetCode.astro';
import IconLogo from '@components/IconLogo.astro';
import IconMeetup from '@components/IconMeetup.astro';
import IconSearch from '@components/IconSearch.astro';
---

<nav
    class="navbar fixed top-0 z-50 w-full border-b border-zinc-900 bg-zinc-950 backdrop-blur-md"
    aria-label="Main"
>
    <div class="flex items-center justify-between max-w-7xl mx-auto px-[clamp(1rem,calc(0.5rem+2.5vw),2.5rem)] py-[clamp(0.75rem,calc(0.5rem+1.25vw),1.5rem)]">
        <a
            class="focus-visible:opacity-80 hover:opacity-80 duration-(--duration-base) transition-opacity"
            aria-label="Home"
            href="/"
        >
            <IconLogo />
        </a>
        <search class="flex-1 relative max-w-xl mx-[clamp(1rem,calc(0.67rem+1.67vw),2rem)]">
            <input
                id="search-input"
                class="focus-visible:bg-zinc-900 focus-visible:border-cyan-80 hover:bg-zinc-900 hover:border-zinc-600 w-full pl-[clamp(2rem,calc(1.67rem+1.67vw),3rem)] px-[clamp(0.75rem,calc(0.5rem+1.25vw),1.5rem)] py-[clamp(0.5rem,calc(0.33rem+0.83vw),1rem)] border border-zinc-800 rounded-lg font-mono text-[clamp(0.875rem,calc(0.79rem+0.42vw),1.125rem)] bg-zinc-950 placeholder-zinc-400 text-zinc-300 duration-(--duration-base) transition-colors"
                aria-autocomplete="list"
                aria-controls="search-results"
                aria-expanded="false"
                aria-label="Search problems"
                autocomplete="off"
                placeholder="Search&hellip;"
                role="combobox"
                type="text"
            />
            <IconSearch />
            <kbd
                class="absolute hidden right-3.5 top-1/2 px-2 py-1 border border-zinc-700 rounded font-mono text-xs text-zinc-600 -translate-y-1/2 pointer-events-none select-none sm:inline-block"
                aria-hidden="true"
            >
                /
            </kbd>
            <div
                id="search-results"
                class="navbar__results absolute left-0 overflow-y-auto right-0 top-full mt-4 border border-zinc-800 rounded-lg bg-zinc-900 backdrop-blur-md duration-(--duration-base) opacity-0 transition-opacity pointer-events-none"
                aria-label="Search results"
                role="listbox"
                tabindex="-1"
            />
        </search>
        <div class="flex items-center gap-[clamp(1rem,calc(0.67rem+1.67vw),2rem)]">
            <a
                class="focus-visible:opacity-80 hover:opacity-80 duration-(--duration-base) transition-opacity"
                aria-label="Meetup (opens in new tab)"
                href="https://meetup.com/algoatx"
                target="_blank"
            >
                <IconMeetup />
            </a>
            <a
                class="focus-visible:opacity-80 hover:opacity-80 duration-(--duration-base) transition-opacity"
                aria-label="LeetCode (opens in new tab)"
                href="https://leetcode.com/u/aephonics"
                target="_blank"
            >
                <IconLeetCode />
            </a>
        </div>
    </div>
</nav>

<div class="h-[clamp(3rem,calc(1.33rem+8.33vw),8rem)]" aria-hidden="true" />

<script>
    interface SearchEntry {
        difficulty: string;
        id: string;
        title: string;
    }

    const BADGE_STYLES: Record<string, { classes: string; label: string }> = {
        ds: { classes: 'bg-cyan-15 text-cyan', label: 'DS' },
        easy: { classes: 'bg-easy-15 text-easy', label: 'easy' },
        hard: { classes: 'bg-hard-15 text-hard', label: 'hard' },
        medium: { classes: 'bg-medium-15 text-medium', label: 'medium' },
    };

    const MAX_RESULTS = 20;

    let activeIndex = -1;
    let cleanup: (() => void) | null = null;
    let indexPromise: Promise<SearchEntry[]> | null = null;
    let pointerInResults = false;

    function escapeHtml(text: string) {
        return text
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    async function fetchIndex() {
        try {
            const response = await fetch('/api/search');

            if (!response.ok) throw new Error('search index unavailable');

            const data: SearchEntry[] = await response.json();

            return data;
        } catch {
            indexPromise = null;

            return [];
        }
    }

    function initSearch() {
        cleanup?.();

        const input = document.getElementById('search-input') as HTMLInputElement;
        const results = document.getElementById('search-results') as HTMLElement;

        const combobox = input.closest('search') as HTMLElement;

        if (!combobox || !input || !results) return;

        function hideResults() {
            activeIndex = -1;
            pointerInResults = false;
            input.removeAttribute('aria-activedescendant');
            input.setAttribute('aria-expanded', 'false');
            toggleResults(false);
        }

        function onDocClick(e: MouseEvent) {
            const target = e.target as Node;

            if (!input.contains(target) && !results.contains(target)) {
                hideResults();
            }
        }

        function onDocKeydown(e: KeyboardEvent) {
            if (document.activeElement !== input && e.key === '/') {
                e.preventDefault();
                input.focus();

                return;
            }

            if (e.key === 'Escape') {
                input.value = '';
                hideResults();
            }
        }

        function onFocus() {
            if (input.value) search(input.value);
        }

        function onFocusOut(e: FocusEvent) {
            const next = e.relatedTarget as Node | null;

            if (next && !combobox.contains(next)) hideResults();
        }

        function onInput(e: Event) {
            search((e.target as HTMLInputElement).value);
        }

        function onInputKeydown(e: KeyboardEvent) {
            const items = results.querySelectorAll<HTMLAnchorElement>('.navbar__result');

            if (!items.length) return;

            if (e.key === 'ArrowDown') {
                e.preventDefault();

                const next = activeIndex < items.length - 1 ? activeIndex + 1 : 0;

                setActiveResult(next);
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();

                const prev = activeIndex > 0 ? activeIndex - 1 : items.length - 1;

                setActiveResult(prev);
            } else if (activeIndex >= 0 && e.key === 'Enter') {
                e.preventDefault();
                items[activeIndex].click();
            }
        }

        function onResultsPointerLeave() {
            pointerInResults = false;
        }

        function renderResults(matches: SearchEntry[]) {
            input.removeAttribute('aria-activedescendant');

            if (matches.length === 0) {
                activeIndex = -1;

                results.innerHTML = [
                    '<div class="navbar__result-text px-4 py-2.5 text-zinc-400">',
                    'No results',
                    '</div>',
                ].join('');
            } else {
                results.innerHTML = matches.slice(0, MAX_RESULTS).map((entry, i) => {
                    const badge = BADGE_STYLES[entry.difficulty] ?? BADGE_STYLES.hard;

                    return [
                        `<a`,
                        ` id="search-result-${i}"`,
                        ` class="navbar__result navbar__result-text flex items-center justify-between gap-3 px-4 py-2.5 text-zinc-300 duration-(--duration-instant) transition-colors"`,
                        ` href="/p/${entry.id}"`,
                        ` role="option"`,
                        ` tabindex="-1"`,
                        `>`,
                        `<span class="truncate">${escapeHtml(entry.title)}</span>`,
                        `<span class="navbar__badge hidden px-2 py-0.5 rounded-full font-mono tracking-wider uppercase sm:inline-block ${badge.classes}">${badge.label}</span>`,
                        `</a>`,
                    ].join('');
                }).join('');

                results.querySelectorAll<HTMLAnchorElement>('.navbar__result').forEach((item, i) => {
                    item.addEventListener('pointerenter', () => {
                        pointerInResults = true;
                        setActiveResult(i);
                    });
                });

                if (!pointerInResults) setActiveResult(0);
            }
        }

        async function search(query: string) {
            const normalizedQuery = query.trim().toLowerCase();

            if (!normalizedQuery) {
                hideResults();

                return;
            }

            const index = await loadIndex();

            if (input.value !== query) return;

            const matches = index
                .filter(entry => entry.id === normalizedQuery || entry.title.toLowerCase().includes(normalizedQuery))
                .sort(sortResults);

            renderResults(matches);
            input.setAttribute('aria-expanded', 'true');
            toggleResults(true);
        }

        function setActiveResult(index: number) {
            const items = results.querySelectorAll<HTMLAnchorElement>('.navbar__result');

            activeIndex = index;
            items.forEach(item => item.removeAttribute('aria-selected'));

            if (index >= 0 && index < items.length) {
                const item = items[index];

                input.setAttribute('aria-activedescendant', item.id);
                item.setAttribute('aria-selected', 'true');
                item.scrollIntoView({ block: 'nearest' });
            } else {
                input.removeAttribute('aria-activedescendant');
            }
        }

        function toggleResults(visible: boolean) {
            results.classList.toggle('opacity-0', !visible);
            results.classList.toggle('opacity-100', visible);
            results.classList.toggle('pointer-events-auto', visible);
            results.classList.toggle('pointer-events-none', !visible);
        }

        loadIndex();
        combobox.addEventListener('focusout', onFocusOut);
        document.addEventListener('click', onDocClick);
        document.addEventListener('keydown', onDocKeydown);
        input.addEventListener('focus', onFocus);
        input.addEventListener('input', onInput);
        input.addEventListener('keydown', onInputKeydown);
        results.addEventListener('pointerleave', onResultsPointerLeave);
        input.dataset.ready = '';

        cleanup = () => {
            combobox.removeEventListener('focusout', onFocusOut);
            document.removeEventListener('click', onDocClick);
            document.removeEventListener('keydown', onDocKeydown);
            input.removeEventListener('focus', onFocus);
            input.removeEventListener('input', onInput);
            input.removeEventListener('keydown', onInputKeydown);
            results.removeEventListener('pointerleave', onResultsPointerLeave);
        };
    }

    function loadIndex() {
        indexPromise ??= fetchIndex();

        return indexPromise;
    }

    function sortResults(a: SearchEntry, b: SearchEntry) {
        if (a.difficulty === 'ds' && b.difficulty !== 'ds') return -1;
        if (a.difficulty !== 'ds' && b.difficulty === 'ds') return 1;
        if (a.difficulty !== 'ds' && b.difficulty !== 'ds') return parseInt(a.id) - parseInt(b.id);

        return a.title.localeCompare(b.title);
    }

    document.addEventListener('astro:page-load', initSearch);
</script>
