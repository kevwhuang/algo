---
import { CLASS_BUTTON, CLASS_ERROR_CODE } from '@lib/constants';
---

<section
    class="section flex items-center justify-center min-h-[calc(100svh-var(--header-height))]"
    aria-labelledby="error-server-title"
>
    <div
        class="shell text-center select-none"
        data-scroll
    >
        <h1
            id="error-server-title"
            class={CLASS_ERROR_CODE}
        >
            500
        </h1>
        <a
            class={CLASS_BUTTON}
            aria-label="Return to home"
            href="/"
        >
            Return
        </a>
    </div>
</section>
