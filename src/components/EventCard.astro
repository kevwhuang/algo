---
interface Props {
    city: string;
    dateTime: string;
    endTime: string;
    title: string;
    url: string;
    venue: string;
}

const WALL_CLOCK_LENGTH = 19;

function formatDate(dateStr: string) {
    const date = new Date(dateStr.slice(0, WALL_CLOCK_LENGTH));

    return {
        day: date.getDate(),
        month: date.toLocaleDateString('en-US', { month: 'short' }),
        time: date.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }),
        weekday: date.toLocaleDateString('en-US', { weekday: 'short' }),
        year: date.getFullYear(),
    };
}

const { city, dateTime, endTime, title, url, venue } = Astro.props;
const endFormatted = formatDate(endTime);
const formatted = formatDate(dateTime);
---

<a
    class="meetup-events__card group block p-[clamp(1.5rem,calc(0.67rem+4.17vw),4rem)] border border-white-10"
    aria-label={`${title} \u2014 ${formatted.weekday} ${formatted.month} ${formatted.day}, ${formatted.year} at ${formatted.time} (opens in new tab)`}
    data-scroll="up"
    href={url}
    target="_blank"
>
    <div class="flex flex-col gap-[clamp(0.75rem,calc(0.5rem+1.25vw),1.5rem)] md:flex-row md:gap-[clamp(2rem,calc(1.67rem+1.67vw),3rem)] md:items-center">
        <time
            class="flex flex-col items-center shrink-0 border-white-10 text-center md:border-r md:pr-[clamp(1rem,calc(0.33rem+3.33vw),3rem)] md:w-[clamp(6rem,calc(4.67rem+6.67vw),10rem)]"
            datetime={dateTime}
        >
            <span class="text-[clamp(0.625rem,calc(0.54rem+0.42vw),0.875rem)] tracking-[0.2em] uppercase text-zinc-300">
                {formatted.weekday}
            </span>
            <span
                class="meetup-events__day font-bold leading-tight text-[clamp(2.5rem,calc(1.83rem+3.33vw),4.5rem)]"
                data-day={String(formatted.day)}
            >
                {formatted.day}
            </span>
            <span class="text-[clamp(0.75rem,calc(0.67rem+0.42vw),1rem)] tracking-[0.15em] uppercase text-zinc-200">
                {formatted.month} {formatted.year}
            </span>
        </time>
        <div class="flex flex-col flex-1 min-w-0 gap-[clamp(0.75rem,calc(0.5rem+1.25vw),1.5rem)] text-[clamp(0.875rem,calc(0.79rem+0.42vw),1.125rem)] text-center text-zinc-300 md:text-left">
            <h3 class="meetup-events__name order-2 font-semibold leading-snug text-[clamp(1.25rem,calc(0.92rem+1.67vw),2.25rem)] text-center text-zinc-200 duration-(--duration-base) transition-colors md:order-none md:text-left">
                {title}
            </h3>
            <p class="order-1 md:order-none">
                <span aria-hidden="true">&#128336;</span>
                &ensp;
                <span class="sr-only">Time: </span>
                {formatted.time} &ndash; {endFormatted.time}
            </p>
            {(city || venue) && (
                <p class="order-3 md:order-none">
                    <span aria-hidden="true">&#128205;</span>
                    &ensp;
                    <span class="sr-only">Location: </span>
                    {[venue, city].filter(Boolean).join(', ')}
                </p>
            )}
        </div>
        <span
            class="meetup-events__arrow hidden shrink-0 text-[clamp(1rem,calc(0.67rem+1.67vw),2rem)] text-zinc-700 duration-(--duration-base) transition-[color,transform] select-none md:block"
            aria-hidden="true"
        >
            &rarr;
        </span>
    </div>
</a>
